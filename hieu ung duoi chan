local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- // CẤU HÌNH HIỆU ỨNG (Bạn có thể chỉnh sửa ở đây)
local CIRCLE_SIZE = 6 -- Độ rộng của vòng tròn dưới chân (Cỡ vừa)
local EFFECT_COLOR = Color3.fromRGB(0, 140, 255) -- Màu xanh dương Neon
local PULSE_SPEED = 3 -- Tốc độ nhấp nháy/mờ dần (Càng cao càng nhanh)

local VisualPart = nil
local Mesh = nil

-- // 1. HÀM KHỞI TẠO VÒNG TRÒN DƯỚI ĐẤT (Cấu trúc chống lỗi hiển thị)
local function CreateFootCircle()
	-- Nếu có part cũ thì xóa đi để tránh trùng lặp
	if VisualPart then VisualPart:Destroy() end
	
	-- Tạo một Part cơ sở dạng hộp để chứa Mesh hình tròn
	VisualPart = Instance.new("Part")
	VisualPart.Name = "ZyronX_FootRing"
	VisualPart.Size = Vector3.new(CIRCLE_SIZE, 0.2, CIRCLE_SIZE)
	VisualPart.Color = EFFECT_COLOR
	VisualPart.Material = Enum.Material.Neon -- Chất liệu phát sáng
	VisualPart.CanCollide = false -- Đi xuyên qua tường/sàn
	VisualPart.Anchored = true -- Cố định vị trí xử lý bằng script
	VisualPart.CastShadow = false -- Không đổ bóng để tối ưu FPS
	
	-- Tạo SpecialMesh để biến Part thành một hình tròn/vòng nhẫn dẹt hoàn hảo dưới đất
	Mesh = Instance.new("SpecialMesh")
	Mesh.MeshType = Enum.MeshType.FileMesh
	-- Sử dụng ID Mesh vòng nhẫn rỗng (Ring) chính thức của Roblox
	Mesh.MeshId = "rbxassetid://3270017" 
	Mesh.Scale = Vector3.new(CIRCLE_SIZE, CIRCLE_SIZE, 0.5)
	Mesh.Parent = VisualPart
	
	VisualPart.Parent = workspace
end

-- // KÍCH HOẠT TẠO VÒNG TRÒN NGAY KHI CHẠY SCRIPT
CreateFootCircle()

-- // 2. VÒNG LẶP RENDERSTEPPED (Cập nhật vị trí và tạo hiệu ứng nhấp nháy mờ dần)
local timeElapsed = 0

RunService.RenderStepped:Connect(function(dt)
	-- Nếu vì lý do gì đó Part bị xóa (ví dụ reset nhân vật), tự động tạo lại
	if not VisualPart or VisualPart.Parent == nil then
		CreateFootCircle()
		return
	end
	
	local character = LocalPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	-- Kiểm tra nhân vật hợp lệ và còn sống
	if rootPart and humanoid and humanoid.Health > 0 then
		-- Tính toán thời gian để làm hiệu ứng mờ dần (Fade) theo vòng lặp sin
		timeElapsed = timeElapsed + dt * PULSE_SPEED
		local transparencyValue = 0.2 + (math.sin(timeElapsed) * 0.4) -- Dao động độ mờ từ 0.2 đến 0.6
		
		VisualPart.Transparency = transparencyValue
		
		-- Xác định vị trí mặt đất dưới chân nhân vật (Hạ thấp hơn HumanoidRootPart khoảng 3 stud)
		local raycastOrigin = rootPart.Position
		local raycastDirection = Vector3.new(0, -10, 0) -- Bắn một tia xuống dưới sàn
		
		local raycastParams = RaycastParams.new()
		raycastParams.FilterDescendantsInstances = {character, VisualPart}
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		
		local raycastResult = workspace:Raycast(raycastOrigin, raycastDirection, raycastParams)
		
		if raycastResult then
			-- Nếu chân chạm sàn: Ghim vòng tròn khít với bề mặt sàn (Không lo bị chìm hay bay lơ lửng)
			VisualPart.Position = raycastResult.Position + Vector3.new(0, 0.05, 0)
		else
			-- Nếu đang nhảy trên không: Giữ vị trí dưới chân nhân vật cố định
			VisualPart.Position = rootPart.Position - Vector3.new(0, 3, 0)
		end
	else
		-- Nếu nhân vật chết: Ẩn hiệu ứng đi
		VisualPart.Transparency = 1
	end
end)
